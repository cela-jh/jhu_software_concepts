# Copy to .env (same folder) and replace each value with your own. .env
# is gitignored; never commit real credentials. Variables already
# exported in your shell take precedence over this file.

# PostgreSQL connection, as the least-privilege app role created by
# least_privilege.sql (SELECT, INSERT, UPDATE on applicants only).
# localhost and 5432 are PostgreSQL's usual local defaults; change them
# if your server runs elsewhere.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=gradcafe_app
DB_PASSWORD=your_app_role_password

# Absolute path to your Chrome binary, needed only for Pull Data.
CHROME_BINARY=/path/to/chrome

# Top-level dependencies, edited by hand. requirements.txt is generated
# from this file and pins every transitive dependency too, so pip and
# `uv pip sync` both rebuild the same environment. After editing, run
# from module_5:
#     uv pip compile requirements.in --universal --python-version 3.12 -o requirements.txt


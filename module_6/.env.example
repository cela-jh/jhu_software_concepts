# PostgreSQL credentials (single source of truth).
# POSTGRES_PASSWORD is the only secret you need to change; Docker Compose
# and the test suite both derive DATABASE_URL from these values.
POSTGRES_USER=gradcafe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gradcafe_db

# DATABASE_URL is constructed by docker-compose.yml from the POSTGRES_*
# vars above, so it does not need to be set here. For running the web
# container standalone (without Compose), pass it on the docker run
# command line using host.docker.internal as the host.

# RabbitMQ (guest/guest is the built-in default for local dev)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Flask
FLASK_ENV=development
FLASK_SECRET=change-this-secret

# Worker
SEED_JSON=/app/data/applicant_data.json
TARGET_TABLE=applicants
ID_KEY=p_id
